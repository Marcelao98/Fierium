{
  "name": "fierium",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @fierium/app dev",
    "build": "pnpm --filter @fierium/app build",
    "preview": "pnpm --filter @fierium/app preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @fierium/app e2e",
    "tauri": "tauri",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "cartoes": "node ferramentas/cartoes/painel.mjs",
    "despachar": "node ferramentas/cartoes/despachar.mjs",
    "check:tudo": "pnpm check && pnpm check:rust",
    "pacote:linux": "tauri build --bundles deb appimage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
